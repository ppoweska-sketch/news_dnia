# Ten plik jest tylko do TESTÓW LOKALNYCH. Produkcja działa przez GitHub
# Actions (.github/workflows/daily-news.yml) i tam jedynym sekretem jest
# GEMINI_API_KEY dodany w Settings → Secrets and variables → Actions —
# GITHUB_TOKEN/OWNER/REPO nie są potrzebne, bo Actions ma wbudowane
# uwierzytelnienie do własnego repo.
#
#   cp .env.example .env
#   chmod 600 .env

# Klucz Gemini API (darmowy) — aistudio.google.com/apikey
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ścieżka do tego repozytorium na Twoim komputerze — lokalny test i tak
# robi prawdziwy `git push`, więc to musi być katalog ze skonfigurowanym
# dostępem do zdalnego repo.
REPO_DIR=.

# Podkatalog w REPO_DIR, do którego trafia wygenerowany index.html.
# Musi się zgadzać z ustawieniem GitHub Pages (Settings -> Pages -> folder).
SITE_SUBDIR=docs

# Gałąź, na którą robimy push (najczęściej: main)
GITHUB_BRANCH=main

# Opcjonalnie — model i limit tokenów wyjścia.
# Nazwy modeli Gemini zmieniają się regularnie — jeśli GEMINI_MODEL przestanie
# działać (błąd "model not found"), sprawdź aktualną listę na
# https://ai.google.dev/gemini-api/docs/models. Musi być z rodziny
# Flash/Flash-Lite, żeby łapać się na darmowy poziom (Pro jest płatne
# od kwietnia 2026).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=16000

# Budżet "myślenia" modelu; 0 = wyłączone (zadanie to klasyfikacja
# i streszczanie z gotowych materiałów, nie złożone rozumowanie — wyłączone
# myślenie jest tańsze i szybsze bez utraty jakości). Zostaw puste, jeśli
# wybrany model nie obsługuje tego parametru.
GEMINI_THINKING_BUDGET=0

# Ile wątków przy pobieraniu kanałów RSS i treści artykułów. Domyślnie 8
# (bezpieczne na zwykłym komputerze/runnerze Actions). Obniż, jeśli
# uruchamiasz to na maszynie współdzielonej z czymś pamięciowo wrażliwym.
RSS_WORKERS=8
