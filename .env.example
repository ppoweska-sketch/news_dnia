# Ten plik jest tylko do TESTÓW LOKALNYCH. Produkcja działa przez GitHub
# Actions (.github/workflows/daily-news.yml) i tam jedynym sekretem jest
# ANTHROPIC_API_KEY dodany w Settings → Secrets and variables → Actions —
# GITHUB_TOKEN/OWNER/REPO nie są potrzebne, bo Actions ma wbudowane
# uwierzytelnienie do własnego repo.
#
#   cp .env.example .env
#   chmod 600 .env

# Klucz Anthropic API (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ścieżka do tego repozytorium na Twoim komputerze — lokalny test i tak
# robi prawdziwy `git push`, więc to musi być katalog ze skonfigurowanym
# dostępem do zdalnego repo.
REPO_DIR=.

# Podkatalog w REPO_DIR, do którego trafia wygenerowany index.html.
# Musi się zgadzać z ustawieniem GitHub Pages (Settings -> Pages -> folder).
SITE_SUBDIR=docs

# Gałąź, na którą robimy push (najczęściej: main)
GITHUB_BRANCH=main

# Skąd brać newsy:
#   rss           — kanały RSS (23 polskojęzyczne źródła), tanio, linki pewne
#   claude_search — model sam szuka przez web_search, szerzej ale wielokrotnie drożej
NEWS_SOURCE=rss

# Opcjonalnie — model, limity i głębokość rozumowania.
# ANTHROPIC_EFFORT: low | medium | high | xhigh | max (im wyżej, tym drożej)
# ANTHROPIC_MAX_TOKENS obejmuje myślenie modelu ORAZ tekst raportu (50 newsów).
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=40000
ANTHROPIC_EFFORT=medium

# Tylko dla NEWS_SOURCE=claude_search:
ANTHROPIC_MAX_SEARCHES=50
ANTHROPIC_MAX_CONTINUATIONS=10

# Ile wątków przy pobieraniu kanałów RSS i treści artykułów. Domyślnie 8
# (bezpieczne na zwykłym komputerze/runnerze Actions). Obniż, jeśli
# uruchamiasz to na maszynie współdzielonej z czymś pamięciowo wrażliwym.
RSS_WORKERS=8
